# Keep DOS-facing text files as CRLF so they read correctly on DOS/Notepad
*.TXT   text eol=crlf
*.DIZ   text eol=crlf
*.CFG   text eol=crlf
*.DEF   text eol=crlf
*.BAT   text eol=crlf
*.NFO   text eol=crlf
# Source and docs stay LF
*.pas   text eol=lf
*.md    text eol=lf
*.inc   text eol=lf
# Binaries: never touch
*.EXE   binary
*.FNT   binary
*.JHR   binary
*.JDT   binary
*.gz    binary
