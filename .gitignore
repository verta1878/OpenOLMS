# Free Pascal build artifacts
*.o
*.ppu
*.a
*.compiled
*.res
lib/
# built executables
olms
config
config_demo
examples/jam_pipeline_test
examples/olms_qwk_demo
*.exe
# editor/OS
*~
.DS_Store
link*.res
ppas.sh

# DOS runtime (CWSDPMI) IS part of the repo despite the *.exe rule above
!dos-runtime/CWSDPMI.EXE
!dos-runtime/CWSDPR0.EXE

# DOS cross-toolchain IS part of the repo (binaries + their source travel together)
!toolchain/bin/ppcross386
!toolchain/units/go32v2/*.ppu
!toolchain/units/go32v2/*.o
!toolchain/fpc-3.2.2.source.tar.gz

# Mystic SDL font (needed by the SDL UI backend)
!src/mystic_sdl/VGA8X16.FNT
src/*.EXE
